  .kl2-bar { position: sticky; top: 0; z-index: 30; display: flex; flex-wrap: wrap; gap: 4px 10px; justify-content: center; align-items: center; padding: 9px 16px; background: var(--acc); color: var(--acc-ink); font-size: 14px; text-align: center; }
  .kl2-bar[hidden] { display: none; }
