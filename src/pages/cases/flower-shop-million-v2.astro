---
/** Кейс-лендинг, вариант 2 – жёстче и продающе (просьба владельца 14.11.2026).
    Тот же кейс, что и flower-shop-million: цифры из кейсов Дениса на vc.ru (21.09.2026)
    и скринов кабинета ВК Рекламы, оборот – со слов клиента. Новое: удар по переплате
    на первом экране, калькулятор переплаты, счётчик до ближайшего праздника,
    сравнение «вы сейчас / магазин из кейса», что входит в разбор, финал «два пути».
    Стили – общие с вариантом 1 (скопированы) + блок v2 внизу. */
import Flowers from '../../layouts/Flowers.astro';
import Footer from '../../components/Footer.astro';
import CookieNotice from '../../components/CookieNotice.astro';
import Popup from '../../components/Popup.astro';
import DocPopups from '../../components/DocPopups.astro';

const I = '/tf-flowers/img/cases/';
const FORM = '#popup:myform';

const holes = [
  ['01', 'Букет в ленте – и в никуда', 'Реклама ведёт на пост или в группу. Человек лайкнул и ушёл. Вы заплатили за лайк, а не за заказ.', 'заявка по 2 500–3 000 ₽'],
  ['02', 'Реклама на весь город', 'Вы кормите рекламой людей с другого конца города, которым не повезёте букет вовремя. А соседи из ЖК рядом покупают у конкурента.', 'деньги на тех, кто не закажет'],
  ['03', 'Купил – и забыт', 'Базы нет. Каждый праздник вы покупаете того же клиента заново. И снова платите 3 000 ₽.', 'каждый праздник – с нуля'],
];

const compare = [
  ['Цена обращения', '2 500–3 000 ₽', '251 ₽'],
  ['Куда ведёт реклама', 'на пост или в группу', 'посадочная → подписка → чат-бот → флорист'],
  ['Кому показываем', 'весь город', 'районы доставки и ЖК рядом'],
  ['Что остаётся после рекламы', 'ничего', 'база, которой пишем перед каждым праздником'],
  ['Оборот', '580 000 ₽', '1 180 000 ₽ – рекорд к 1 сентября'],
];

const stack = [
  ['Разбор вашего кабинета', 'Где утекают деньги: какие кампании жгут бюджет, а какие стоит усилить.'],
  ['Разбор вашей группы', 'Почему человек из рекламы не пишет и что поменять, чтобы писал.'],
  ['Расчёт под ваш город', 'Сколько обращений реально получить и по какой цене.'],
  ['План к ближайшему празднику', 'Что запустить и когда, чтобы праздник не прошёл мимо кассы.'],
];

const videos = [
  ['qanCz44Rme7zJXBcPZJFEH', 'Алексей', 'цветочный магазин, Тюмень', '«Результат, конечно, впечатлил. Самое главное – продажи с этого канала есть»'],
  ['pB2kHWLuyFSAMz9HB5YH5f', 'Антон Зайцев', 'цветочный магазин, Нижний Новгород', '«От меня не требуют постоянно делать креативы. Ребята полностью сами всё настраивают – и технику, и маркетинг»'],
  ['sdDRmLfYR18D3GDpCJG4vD', 'Руслан', 'сеть салонов Boombox, Пенза', '«Был таргетолог, его работа не очень устраивала. За короткое время Денис проявился как профессионал своего дела»'],
];
---

<Flowers
  title="Вы платите 3 000 ₽ за заявку на букет. Цветочный из кейса – 251 ₽"
  description="Кейс рекламы ВКонтакте для цветочного магазина: 251 ₽ за тёплое обращение вместо 2 500–3 000 ₽, оборот с 580 000 до 1 180 000 ₽. Посчитайте свою переплату."
  canonical="https://targetfactory.ru/flowers/cases/flower-shop-million-v2/"
>
  <main class="kl kl2">
    <div class="kl2-bar" data-kl2-holiday hidden>
      <span>До <b data-kl2-hname>праздника</b> – <b data-kl2-days>0</b> дн.</span> <span class="kl2-bar__why">Базу под праздник собирают заранее, а не в день праздника.</span>
      <a href={FORM}>Успеть →</a>
    </div>

    <header class="kl-top">
      <div class="kl-wrap kl-top__in">
        <img src={I + 'denis.webp'} alt="" width="40" height="40" class="kl-top__ava" />
        <div><b>Денис Коротаев</b><span>Реклама для цветочных магазинов · Target Factory</span></div>
      </div>
    </header>

    <!-- 1. Удар по переплате -->
    <section class="kl-hero">
      <div class="kl-wrap kl-hero__grid">
        <div>
          <span class="kl-pill">● Реальный кейс · цветочный магазин · ВКонтакте</span>
          <h1 class="kl-h1">Вы платите <s>3 000 ₽</s> за заявку на букет. <em>Этот цветочный – 251 ₽</em></h1>
          <p class="kl-lead">И за три месяца поднял оборот с 580 000 до <b>1 180 000 ₽</b>. Без интернет-магазина. Без скидок 40%. Без розыгрышей, которые съедают маржу. Ниже – как именно, со скринами кабинета.</p>
          <div class="kl-facts">
            <div><b>×10</b><span>дешевле<br />обращение</span></div>
            <div><b>209</b><span>тёплых обращений<br />за 52 556 ₽</span></div>
            <div><b>×2</b><span>рекорд<br />оборота</span></div>
          </div>
          <a class="kl-btn" href={FORM}>Хочу заявки по 251 ₽, а не по 3 000</a>
          <p class="kl-under">Сначала бесплатный разбор вашей рекламы. Потом решаете, работать ли.</p>
        </div>
        <figure class="kl-shot kl-shot--hero">
          <img src={I + 'kabinet-209.webp'} alt="Кабинет ВК Рекламы: 209 подписок по 251,47 ₽, потрачено 52 556,30 ₽" width="1400" height="690" />
          <figcaption>Кабинет ВК Рекламы. Нажмите – рассмотрите каждую цифру.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. Калькулятор переплаты -->
    <section class="kl-sec kl2-calc-sec">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag">Посчитайте сами</span>
        <h2 class="kl-h2">Сколько вы <em>переплачиваете</em> каждый месяц?</h2>
        <div class="kl2-calc" data-kl2-calc>
          <label>Сколько заявок с рекламы в месяц
            <input type="number" inputmode="numeric" min="1" max="2000" value="30" data-kl2-n />
          </label>
          <label>Сколько стоит одна заявка сейчас, ₽
            <input type="number" inputmode="numeric" min="252" max="20000" value="2500" data-kl2-p />
          </label>
          <div class="kl2-calc__out">
            <span>Ваша переплата против 251 ₽ за обращение</span>
            <b data-kl2-month>67 470 ₽</b><small>в месяц</small>
            <b class="kl2-calc__year" data-kl2-year>809 640 ₽</b><small>в год</small>
          </div>
        </div>
        <p class="kl-under">Расчёт: (ваша цена − 251 ₽) × число заявок. 251 ₽ – цена тёплого обращения в кейсе ниже.</p>
        <a class="kl-btn" href={FORM}>Хочу перестать переплачивать</a>
      </div>
    </section>

    <!-- 3. Дыры -->
    <section class="kl-sec">
      <div class="kl-wrap">
        <span class="kl-tag">Куда уходят деньги</span>
        <h2 class="kl-h2">Три дыры, <em>через которые цветочные сливают рекламу</em></h2>
        <p class="kl-p">Магазин из кейса до нас запускал рекламу сам. Деньги списывались, заявки шли по 2 500–3 000 ₽. Мы открыли кабинет – и нашли все три. <u>У вас наверняка есть хотя бы одна.</u></p>
        <div class="kl-holes">
          {holes.map(([n, t, d, p]) => (
            <article class="kl-hole">
              <span class="kl-hole__n">Дыра №{n}</span>
              <h3>{t}</h3>
              <p>{d}</p>
              <div class="kl-hole__price">Цена ошибки: <b>{p}</b></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. Сравнение -->
    <section class="kl-sec kl-sec--light">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag kl-tag--dark">Было → стало</span>
        <h2 class="kl-h2">Найдите себя <em>в левой колонке</em></h2>
        <div class="kl2-cmp" role="table">
          <div class="kl2-cmp__row kl2-cmp__head" role="row"><span></span><span>Как у большинства</span><span>Магазин из кейса</span></div>
          {compare.map(([k, a, b]) => (
            <div class="kl2-cmp__row" role="row"><span>{k}</span><span class="is-bad">{a}</span><span class="is-good">{b}</span></div>
          ))}
        </div>
        <blockquote class="kl-quote">17 кампаний в тесте. Выжила одна связка – подписка на рассылку с чат-ботом: 1 908 переходов по 27,55 ₽ и <b>209 тёплых обращений по 251 ₽</b>. И все 209 человек остались в базе магазина.</blockquote>
      </div>
    </section>

    <!-- 5. Доказательства -->
    <section class="kl-sec">
      <div class="kl-wrap">
        <span class="kl-tag">Это не одна удача</span>
        <h2 class="kl-h2">Три цветочных. <em>Три кабинета. Один результат</em></h2>
        <div class="kl2-proof">
          <figure class="kl-shot"><img src={I + 'kabinet-209.webp'} alt="Магазин 1: 209 обращений по 251,47 ₽" width="1400" height="690" loading="lazy" /><figcaption><b>251 ₽</b> вместо 2 500–3 000 ₽ · оборот 580 000 → 1 180 000 ₽ (со слов владельца)</figcaption></figure>
          <figure class="kl-shot"><img src={I + 'kabinet-215.webp'} alt="Магазин 2: 140 по 232,93 ₽ и 75 по 268,05 ₽" width="1270" height="625" loading="lazy" /><figcaption><b>245 ₽</b> · 215 обращений · у магазина не было сайта</figcaption></figure>
          <figure class="kl-shot"><img src={I + 'kabinet-400.webp'} alt="Магазин 3: 112 подписок по 393,68 ₽" width="1400" height="500" loading="lazy" /><figcaption><b>394 ₽</b> вместо 1 500–2 000 ₽ · второй месяц работы</figcaption></figure>
        </div>
        <div class="kl-videos">
          {videos.map(([id, who, where, quote]) => (
            <article class="kl-video">
              <button class="kl-video__play" type="button" data-kinescope={id} aria-label={`Смотреть видео-отзыв: ${who}`}>
                <span class="kl-video__icon" aria-hidden="true">▶</span>
                <span class="kl-video__who"><b>{who}</b>{where}</span>
              </button>
              <p>{quote}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Что получите -->
    <section class="kl-sec kl-sec--light">
      <div class="kl-wrap kl2-offer">
        <div>
          <span class="kl-tag kl-tag--dark">Бесплатный разбор</span>
          <h2 class="kl-h2">Что вы получите <em>до того, как заплатите хоть рубль</em></h2>
          <ol class="kl-funnel">
            {stack.map(([t, d], i) => (<li><span>{i + 1}</span><b>{t}</b><small>{d}</small></li>))}
          </ol>
          <a class="kl-btn" href={FORM}>Забрать бесплатный разбор</a>
        </div>
        <figure class="kl-who__photo"><img src={I + 'denis.webp'} alt="Денис Коротаев за рабочим столом, на экране – рекламный кабинет" width="1100" height="773" loading="lazy" /><figcaption class="kl2-cap">Разбор делает сам Денис: 50+ цветочных магазинов, 90% клиентов работают годами</figcaption></figure>
      </div>
    </section>

    <!-- 7. Два пути -->
    <section class="kl-final">
      <div class="kl-wrap kl-narrow">
        <h2 class="kl-h2">У вас <em>два пути</em></h2>
        <div class="kl2-roads">
          <div class="kl2-road is-bad"><b>Оставить как есть</b><p>Платить 3 000 ₽ за заявку, держать полный холодильник без заказов и каждый праздник покупать клиентов заново.</p></div>
          <div class="kl2-road is-good"><b>Сделать как в кейсе</b><p>Обращения по 251 ₽, своя база покупателей и рекорд оборота к празднику.</p></div>
        </div>
        <p class="kl-filter"><b>Сразу честно:</b> нужен рекламный бюджет от 30 000 ₽ в месяц. Меньше – не тест, а лотерея. Если такого бюджета нет – не тратьте ни своё время, ни наше.</p>
        <a class="kl-btn" href={FORM}>Выбираю второй путь</a>
        <p class="kl-under">Бесплатно и без обязательств.</p>
      </div>
    </section>

    <a class="kl-sticky" href={FORM}>Заявки по 251 ₽ – разбор бесплатно</a>
  </main>

  <div id="rec4182947001"><Footer /></div>
  <div id="rec4182947101"><CookieNotice /></div>
  <div id="rec4182986701"><Popup /></div>
  <DocPopups />

  <div class="kl-lb" data-kl-lb hidden>
    <button type="button" aria-label="Закрыть">✕</button>
    <img alt="" />
  </div>
</Flowers>

<style is:global>
  .kl { --bg: #121212; --card: #1c1d1f; --line: #2c2d31; --ink: #f2f2ef; --mut: #a8aaa6; --acc: #b6e42b; --acc-ink: #121212; --warm: #f7f4ee;
    background: var(--bg); color: var(--ink); font: 400 17px/1.55 'Montserrat', system-ui, sans-serif; }
  .kl *, .kl *::before { box-sizing: border-box; }
  .kl-wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .kl-narrow { max-width: 820px; }
  .kl h1, .kl h2, .kl h3 { margin: 0; font-family: 'Oswald', 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: .01em; }
  .kl em { font-style: normal; color: var(--acc); }
  .kl-top { border-bottom: 1px solid var(--line); }
  .kl-top__in { display: flex; gap: 12px; align-items: center; padding-top: 12px; padding-bottom: 12px; font-size: 13px; }
  .kl-top__in b { display: block; font-size: 15px; }
  .kl-top__in span { color: var(--mut); }
  .kl-top__ava { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: 75% 30%; border: 2px solid var(--acc); }
  .kl-hero { padding: 40px 0 56px; }
  .kl-hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 960px) { .kl-hero__grid { grid-template-columns: 1.05fr 1fr; } }
  .kl-pill { display: inline-block; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--mut); }
  .kl-pill::first-letter { color: var(--acc); }
  .kl-h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1.02; margin: 16px 0 18px; }
  .kl-h1 s { color: var(--mut); text-decoration-thickness: 3px; }
  .kl-lead { font-size: clamp(17px, 2vw, 20px); margin: 0 0 22px; }
  .kl-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0 0 24px; }
  .kl-facts div { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px; }
  .kl-facts b { display: block; font: 700 clamp(22px, 3.2vw, 32px)/1 'Oswald', sans-serif; color: var(--acc); }
  .kl-facts span { display: block; margin-top: 6px; font-size: 12.5px; line-height: 1.35; color: var(--mut); }
  .kl-btn { display: inline-flex; justify-content: center; align-items: center; min-height: 60px; padding: 16px 28px; border-radius: 14px; background: var(--acc); color: var(--acc-ink); font-weight: 800; font-size: 17px; text-transform: uppercase; text-decoration: none; text-align: center; box-shadow: 0 10px 40px rgba(182, 228, 43, .28); transition: transform .15s; }
  .kl-btn:hover { transform: translateY(-2px); }
  .kl-btn--sm { min-height: 52px; font-size: 15px; white-space: normal; }
  .kl-under { margin: 10px 0 0; font-size: 14px; color: var(--mut); }
  .kl-shot { margin: 0; }
  .kl-shot img { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line); cursor: zoom-in; background: #fff; }
  .kl-shot--hero img { box-shadow: 0 30px 80px rgba(0, 0, 0, .6), 0 0 0 4px rgba(182, 228, 43, .35); }
  .kl-shot figcaption { margin-top: 8px; font-size: 13px; color: var(--mut); }
  .kl-sec { padding: 64px 0; }
  .kl-sec--light { background: var(--warm); color: #17181b; }
  .kl-sec--light em { color: #4f6b00; }
  .kl-tag { display: inline-block; border-radius: 999px; padding: 6px 14px; background: var(--acc); color: var(--acc-ink); font-size: 12px; font-weight: 800; text-transform: uppercase; }
  .kl-tag--dark { background: #17181b; color: var(--acc); }
  .kl-h2 { font-size: clamp(28px, 4.4vw, 46px); line-height: 1.06; margin: 14px 0 18px; }
  .kl-p { margin: 0 0 16px; font-size: 17px; }
  .kl-p u { text-decoration-color: var(--acc); text-underline-offset: 4px; }
  .kl-holes { display: grid; gap: 14px; margin: 26px 0; }
  @media (min-width: 900px) { .kl-holes { grid-template-columns: repeat(3, 1fr); } }
  .kl-hole { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 22px; }
  .kl-hole__n { align-self: flex-start; background: var(--acc); color: var(--acc-ink); border-radius: 8px; padding: 6px 10px; font: 700 15px 'Oswald', sans-serif; text-transform: uppercase; }
  .kl-hole h3 { font-size: 22px; line-height: 1.15; margin: 14px 0 10px; }
  .kl-hole p { margin: 0 0 16px; color: #d6d7d3; flex: 1; }
  .kl-hole__price { border-top: 1px solid var(--line); padding-top: 12px; font-size: 15px; color: var(--mut); }
  .kl-hole__price b { color: var(--acc); }
  .kl-strip { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 20px 22px; margin-top: 24px; }
  .kl-strip b { display: block; font: 600 22px/1.2 'Oswald', sans-serif; text-transform: uppercase; }
  .kl-strip span { color: var(--mut); font-size: 15px; }
  .kl-funnel { list-style: none; padding: 0; margin: 22px 0; display: grid; gap: 8px; }
  .kl-funnel li { display: grid; grid-template-columns: 40px 1fr; gap: 0 14px; align-items: center; background: #fff; border-radius: 14px; padding: 12px 14px; border: 1px solid #e6e2d8; }
  .kl-funnel li span { grid-row: span 2; width: 40px; height: 40px; border-radius: 50%; background: #17181b; color: var(--acc); display: grid; place-items: center; font: 700 18px 'Oswald', sans-serif; }
  .kl-funnel small { color: #5d6068; font-size: 14px; }
  .kl-quote { margin: 22px 0; padding: 20px 22px; border-left: 6px solid var(--acc); background: #17181b; color: var(--ink); border-radius: 0 14px 14px 0; font-size: 19px; line-height: 1.45; }
  .kl-quote b { color: var(--acc); }
  .kl-fact { display: grid; gap: 20px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 20px; padding: 22px; margin-top: 16px; }
  @media (min-width: 900px) { .kl-fact { grid-template-columns: .8fr 1.2fr; } }
  .kl-fact__n { display: inline-block; background: var(--acc); color: var(--acc-ink); border-radius: 8px; padding: 6px 10px; font: 700 14px 'Oswald', sans-serif; text-transform: uppercase; }
  .kl-fact h3 { font-size: clamp(22px, 2.8vw, 28px); line-height: 1.15; margin: 12px 0 10px; }
  .kl-fact p { margin: 0 0 8px; color: #d6d7d3; }
  .kl-fact small { color: var(--mut); font-size: 13px; }
  .kl-bars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; align-items: end; height: 280px; }
  .kl-bars div { position: relative; height: var(--h); background: #2c2d31; border-radius: 12px 12px 4px 4px; display: flex; flex-direction: column; justify-content: flex-start; padding: 10px; }
  .kl-bars .is-top { background: var(--acc); color: var(--acc-ink); box-shadow: 0 0 40px rgba(182, 228, 43, .35); }
  .kl-bars b { font: 700 clamp(14px, 2vw, 20px)/1.1 'Oswald', sans-serif; }
  .kl-bars span { font-size: 12px; opacity: .8; margin-top: 4px; }
  .kl-videos { display: grid; gap: 14px; margin-top: 24px; }
  @media (min-width: 900px) { .kl-videos { grid-template-columns: repeat(3, 1fr); } }
  .kl-video { background: #fff; border-radius: 18px; border: 1px solid #e6e2d8; overflow: hidden; }
  .kl-video__play { position: relative; display: flex; flex-direction: column; justify-content: space-between; width: 100%; aspect-ratio: 9 / 12; border: 0; cursor: pointer; padding: 18px; text-align: left; color: #fff; background: radial-gradient(circle at 70% 30%, #3a4a10, #121212 70%); font: inherit; }
