---
/** Кейс-лендинг, вариант 3 – «по мозолям» (владелец 15.11.2026: «ещё жёстче, прям на мозоли
    надавить, чтобы бежать к Денису надо»). Кейс тот же: vc.ru (21.09.2026) + скрины кабинета,
    оборот – со слов клиента. Мозоли – из комментариев Дениса (docs/ZADANIE.md) и болей
    с главной: списания, флорист на два фронта, праздник/тишина, сам крутит рекламу,
    пропавший таргетолог, скидки и розыгрыши, клиенты у агрегатора, конкурент рядом.
    Новое: чек-лист «узнаёте себя» со счётом, «что будет, если ничего не менять»,
    сравнение с агентствами словами Дениса, прямые контакты Дениса в один тап.
    Стили – из варианта 2 (скопированы) + блок v3 внизу. */
import Flowers from '../../layouts/Flowers.astro';
import Footer from '../../components/Footer.astro';
import CookieNotice from '../../components/CookieNotice.astro';
import Popup from '../../components/Popup.astro';
import DocPopups from '../../components/DocPopups.astro';

const I = '/tf-flowers/img/cases/';
const FORM = '#popup:myform';
const TG = 'https://t.me/korotaev_denis';
const MAX = 'https://max.ru/u/f9LHodD0cOLcKLkeG8Hr_oFXFF0snzqnNOGgHN2cX0meUwSiovnBh1wb8xM';
const TEL = 'tel:+79132090181';

const pains = [
  'В понедельник выносите в мусор розы, закупленные под выходные',
  'Флорист вместо букетов отвечает «сколько стоит?» и «успеете к шести?»',
  '8 Марта – аврал и ночь без сна, а через неделю – тишина и полный холодильник',
  'Рекламу крутите сами по вечерам – деньги списываются, заказов нет',
  'Таргетолог обещал заявки, через пару месяцев пропал, а связки так и крутятся с первой недели',
  'Делали скидку 40% или розыгрыш – подписчики пришли, денег нет',
  'Заказ приходит с агрегатора – и клиент остаётся его, а не ваш',
  'Цветочный через дорогу как будто знает, где ваши покупатели',
];

const agencies = [
  ['Клиенты уходят через пару месяцев. Про вас забыли, а креативы крутятся с первой недели', '90% клиентов работают с Денисом годами. Он сам сидит в ваших кабинетах'],
  ['«Скидка 40%» и розыгрыши ради активности – маржа уходит в минус', 'Считаем ДРР, окупаемость и средний чек. Акция не должна съедать прибыль'],
  ['Кабинет у подрядчика: ушёл – забрал всё', 'Работаем в вашем кабинете – полный доступ у вас'],
  ['Знают только цветы – взгляд замылен', '50+ цветочных магазинов, плюс приёмы из автобизнеса и ритейла'],
];

const videos = [
  ['qanCz44Rme7zJXBcPZJFEH', 'Алексей', 'цветочный магазин, Тюмень', '«Результат, конечно, впечатлил. Самое главное – продажи с этого канала есть»'],
  ['pB2kHWLuyFSAMz9HB5YH5f', 'Антон Зайцев', 'цветочный магазин, Нижний Новгород', '«От меня не требуют постоянно делать креативы. Ребята полностью сами всё настраивают – и технику, и маркетинг»'],
  ['sdDRmLfYR18D3GDpCJG4vD', 'Руслан', 'сеть салонов Boombox, Пенза', '«Был таргетолог, его работа не очень устраивала. За короткое время Денис проявился как профессионал своего дела»'],
];
---

<Flowers
  title="Пока вы выкидываете розы, этот цветочный сделал 1 180 000 ₽ за месяц"
  description="Кейс рекламы ВКонтакте для цветочного магазина: обращение 251 ₽ вместо 2 500–3 000 ₽, оборот с 580 000 до 1 180 000 ₽. Проверьте, где ваш магазин теряет деньги."
  canonical="https://targetfactory.ru/flowers/cases/flower-shop-million-v3/"
>
  <main class="kl kl2 kl3">
    <div class="kl2-bar" data-kl2-holiday hidden>
      <span>До <b data-kl2-hname>праздника</b> – <b data-kl2-days>0</b> дн.</span> <span class="kl2-bar__why">Кто не собрал базу заранее – снова будет выкидывать цветы.</span>
      <a href={TG} target="_blank" rel="noopener">Написать Денису →</a>
    </div>

    <header class="kl-top">
      <div class="kl-wrap kl-top__in">
        <img src={I + 'denis.webp'} alt="" width="40" height="40" class="kl-top__ava" />
        <div><b>Денис Коротаев</b><span>Реклама для цветочных магазинов · Target Factory</span></div>
        <a class="kl3-top__tg" href={TG} target="_blank" rel="noopener">Telegram</a>
      </div>
    </header>

    <!-- 1. Боль -->
    <section class="kl-hero">
      <div class="kl-wrap kl-hero__grid">
        <div>
          <span class="kl-pill">● Для владельцев цветочных · реальный кейс</span>
          <h1 class="kl-h1">Пока вы выкидываете розы и платите <s>3 000 ₽</s> за заявку, <em>этот цветочный сделал 1 180 000 ₽ за месяц</em></h1>
          <p class="kl-lead">Букеты у него не лучше ваших. Флористы – такие же. Разница одна: <b>его реклама приводит людей по 251 ₽</b> и складывает их в базу, которая покупает к каждому празднику. А ваша – сжигает деньги и забывает покупателя.</p>
          <div class="kl-facts">
            <div><b>251 ₽</b><span>обращение вместо<br />2 500–3 000 ₽</span></div>
            <div><b>209</b><span>тёплых контактов<br />в своей базе</span></div>
            <div><b>×2</b><span>оборот:<br />580 000 → 1 180 000 ₽</span></div>
          </div>
          <a class="kl-btn" href="#mozoli">Проверить, где теряет мой магазин</a>
          <p class="kl-under">8 пунктов, 30 секунд. Честно отметьте, что про вас.</p>
        </div>
        <figure class="kl-shot kl-shot--hero">
          <img src={I + 'kabinet-209.webp'} alt="Кабинет ВК Рекламы: 209 подписок по 251,47 ₽, потрачено 52 556,30 ₽" width="1400" height="690" />
          <figcaption>Кабинет ВК Рекламы этого магазина. Нажмите – каждая цифра настоящая.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. Мозоли -->
    <section class="kl-sec kl-sec--light" id="mozoli">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag kl-tag--dark">Узнаёте себя?</span>
        <h2 class="kl-h2">Отметьте, что было <em>за последний месяц</em></h2>
        <div class="kl3-check" data-kl3-check>
          {pains.map((p) => (
            <label><input type="checkbox" /><span>{p}</span></label>
          ))}
        </div>
        <div class="kl3-verdict" data-kl3-verdict>
          <b data-kl3-count>0 из 8</b>
          <p data-kl3-text>Отметьте всё, что было у вас. Здесь нет правильных ответов – только деньги, которые вы уже теряете.</p>
          <a class="kl-btn kl-btn--sm" href={FORM} data-kl3-btn hidden>Хочу закрыть эти дыры</a>
        </div>
      </div>
    </section>

    <!-- 3. Калькулятор -->
    <section class="kl-sec kl2-calc-sec">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag">Теперь в рублях</span>
        <h2 class="kl-h2">Сколько вы <em>отдаёте за воздух</em> каждый месяц?</h2>
        <div class="kl2-calc">
          <label>Сколько заявок с рекламы в месяц
            <input type="number" inputmode="numeric" min="1" max="2000" value="30" data-kl2-n />
          </label>
          <label>Сколько стоит одна заявка сейчас, ₽
            <input type="number" inputmode="numeric" min="252" max="20000" value="2500" data-kl2-p />
          </label>
          <div class="kl2-calc__out">
            <span>Переплата против 251 ₽ за обращение</span>
            <b data-kl2-month>67 470 ₽</b><small>в месяц</small>
            <b class="kl2-calc__year" data-kl2-year>809 640 ₽</b><small>в год. И это без цветов, которые ушли в мусор</small>
          </div>
        </div>
        <p class="kl-under">Расчёт: (ваша цена − 251 ₽) × число заявок. 251 ₽ – цена тёплого обращения в кейсе.</p>
      </div>
    </section>

    <!-- 4. Правда в лицо -->
    <section class="kl-sec">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag">Правда, которую не скажет ваш таргетолог</span>
        <h2 class="kl-h2">Дело не в ВКонтакте, не в городе и не в флористах. <em>Ваша реклама ведёт людей в никуда</em></h2>
        <p class="kl-p">Человек увидел букет, нажал, попал в ленту группы – и ушёл. Ни следующего шага, ни контакта. Вы заплатили за клик и потеряли его навсегда. К следующему празднику вы купите его заново. И снова – по 3 000 ₽.</p>
        <p class="kl-p">Магазин из кейса жил так же: заявки по 2 500–3 000 ₽, реклама на весь город, никакой базы. Мы поменяли одно – путь человека после клика:</p>
        <ol class="kl-funnel kl3-funnel">
          <li><span>1</span><b>Реклама только по районам доставки</b><small>соседи из ЖК рядом, а не весь город</small></li>
          <li><span>2</span><b>Посадочная с предложением</b><small>а не лента группы</small></li>
          <li><span>3</span><b>Подписка и чат-бот</b><small>человек сам открывает канал связи, бот сразу пишет предложение</small></li>
          <li><span>4</span><b>Флорист получает тёплого покупателя</b><small>а контакт остаётся в базе магазина навсегда</small></li>
        </ol>
        <blockquote class="kl-quote">17 кампаний в тесте. Выжила одна связка: <b>209 тёплых обращений по 251 ₽</b> за 52 556 ₽. Оборот – с 580 000 до рекордных 1 180 000 ₽ к 1 сентября.<br /><small>Оборот – со слов владельца магазина.</small></blockquote>
      </div>
    </section>

    <!-- 5. Что будет, если ничего не менять -->
    <section class="kl-sec kl3-dark">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag kl3-tag--red">Если ничего не менять</span>
        <h2 class="kl-h2">Следующий праздник <em class="kl3-red">пройдёт так же</em></h2>
        <ul class="kl3-future">
          <li>Закупите цветы под праздник – и не продадите часть из них.</li>
          <li>Снова запустите рекламу в последний момент – когда за внимание бьются все цветочные города.</li>
          <li>Снова заплатите по 3 000 ₽ за тех, кого уже покупали в прошлый раз.</li>
          <li>А соседи из ваших ЖК тем временем подпишутся на того, кто собирает базу.</li>
        </ul>
        <a class="kl-btn" href={FORM}>Не хочу так. Хочу разбор</a>
      </div>
    </section>

    <!-- 6. Доказательства -->
    <section class="kl-sec">
      <div class="kl-wrap">
        <span class="kl-tag">Это не одна удача</span>
        <h2 class="kl-h2">Три цветочных. <em>Три кабинета. Один результат</em></h2>
        <div class="kl2-proof">
          <figure class="kl-shot"><img src={I + 'kabinet-209.webp'} alt="Магазин 1: 209 обращений по 251,47 ₽" width="1400" height="690" loading="lazy" /><figcaption><b>251 ₽</b> вместо 2 500–3 000 ₽ · оборот ×2</figcaption></figure>
          <figure class="kl-shot"><img src={I + 'kabinet-215.webp'} alt="Магазин 2: 140 по 232,93 ₽ и 75 по 268,05 ₽" width="1270" height="625" loading="lazy" /><figcaption><b>245 ₽</b> · 215 обращений · даже без сайта</figcaption></figure>
          <figure class="kl-shot"><img src={I + 'kabinet-400.webp'} alt="Магазин 3: 112 подписок по 393,68 ₽" width="1400" height="500" loading="lazy" /><figcaption><b>394 ₽</b> вместо 1 500–2 000 ₽ · второй месяц</figcaption></figure>
        </div>
        <div class="kl-videos">
          {videos.map(([id, who, where, quote]) => (
            <article class="kl-video">
              <button class="kl-video__play" type="button" data-kinescope={id} aria-label={`Смотреть видео-отзыв: ${who}`}>
                <span class="kl-video__icon" aria-hidden="true">▶</span>
                <span class="kl-video__who"><b>{who}</b>{where}</span>
              </button>
              <p>{quote}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Почему не другое агентство -->
    <section class="kl-sec kl-sec--light">
      <div class="kl-wrap kl-narrow">
        <span class="kl-tag kl-tag--dark">Почему Денис, а не «ещё одно агентство»</span>
        <h2 class="kl-h2">Вы уже обжигались. <em>Вот чем здесь иначе</em></h2>
        <div class="kl3-vs">
          {agencies.map(([a, b]) => (
            <div class="kl3-vs__row"><p class="is-bad">{a}</p><p class="is-good">{b}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Бежать к Денису -->
    <section class="kl-final" id="denis">
      <div class="kl-wrap kl3-final">
        <figure class="kl-who__photo"><img src={I + 'denis.webp'} alt="Денис Коротаев за рабочим столом, на экране – рекламный кабинет" width="1100" height="773" loading="lazy" /></figure>
        <div>
          <h2 class="kl-h2">Напишите Денису <em>сегодня</em></h2>
          <p class="kl-p">Он сам откроет ваш кабинет и группу, покажет, где утекают деньги, и скажет, сколько обращений реально получить в вашем городе. Бесплатно. Решение – за вами.</p>
          <div class="kl3-contacts">
            <a class="kl-btn" href={TG} target="_blank" rel="noopener">Написать в Telegram</a>
            <a class="kl3-alt" href={MAX} target="_blank" rel="noopener">Написать в MAX</a>
            <a class="kl3-alt" href={TEL}>Позвонить: +7 913 209-01-81</a>
            <a class="kl3-alt" href={FORM}>Оставить заявку на разбор</a>
          </div>
          <p class="kl-filter"><b>Сразу честно:</b> нужен рекламный бюджет от 30 000 ₽ в месяц. Меньше – лотерея. Если такого бюджета нет – не тратьте ни своё время, ни наше.</p>
        </div>
      </div>
    </section>

    <div class="kl3-sticky">
      <a href={TG} target="_blank" rel="noopener">Telegram</a>
      <a href={TEL}>Позвонить</a>
      <a href={FORM} class="is-main">Разбор</a>
    </div>
  </main>

  <div id="rec4182947001"><Footer /></div>
  <div id="rec4182947101"><CookieNotice /></div>
  <div id="rec4182986701"><Popup /></div>
  <DocPopups />

  <div class="kl-lb" data-kl-lb hidden>
    <button type="button" aria-label="Закрыть">✕</button>
    <img alt="" />
  </div>
</Flowers>

<style is:global>
  .kl { --bg: #121212; --card: #1c1d1f; --line: #2c2d31; --ink: #f2f2ef; --mut: #a8aaa6; --acc: #b6e42b; --acc-ink: #121212; --warm: #f7f4ee;
    background: var(--bg); color: var(--ink); font: 400 17px/1.55 'Montserrat', system-ui, sans-serif; }
  .kl *, .kl *::before { box-sizing: border-box; }
  .kl-wrap { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .kl-narrow { max-width: 820px; }
  .kl h1, .kl h2, .kl h3 { margin: 0; font-family: 'Oswald', 'Montserrat', sans-serif; text-transform: uppercase; letter-spacing: .01em; }
  .kl em { font-style: normal; color: var(--acc); }
  .kl-top { border-bottom: 1px solid var(--line); }
  .kl-top__in { display: flex; gap: 12px; align-items: center; padding-top: 12px; padding-bottom: 12px; font-size: 13px; }
  .kl-top__in b { display: block; font-size: 15px; }
  .kl-top__in span { color: var(--mut); }
  .kl-top__ava { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: 75% 30%; border: 2px solid var(--acc); }
  .kl-hero { padding: 40px 0 56px; }
  .kl-hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 960px) { .kl-hero__grid { grid-template-columns: 1.05fr 1fr; } }
  .kl-pill { display: inline-block; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 700; text-transform: uppercase; color: var(--mut); }
  .kl-pill::first-letter { color: var(--acc); }
  .kl-h1 { font-size: clamp(36px, 6vw, 64px); line-height: 1.02; margin: 16px 0 18px; }
  .kl-h1 s { color: var(--mut); text-decoration-thickness: 3px; }
  .kl-lead { font-size: clamp(17px, 2vw, 20px); margin: 0 0 22px; }
  .kl-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0 0 24px; }
  .kl-facts div { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 12px; }
  .kl-facts b { display: block; font: 700 clamp(22px, 3.2vw, 32px)/1 'Oswald', sans-serif; color: var(--acc); }
  .kl-facts span { display: block; margin-top: 6px; font-size: 12.5px; line-height: 1.35; color: var(--mut); }
  .kl-btn { display: inline-flex; justify-content: center; align-items: center; min-height: 60px; padding: 16px 28px; border-radius: 14px; background: var(--acc); color: var(--acc-ink); font-weight: 800; font-size: 17px; text-transform: uppercase; text-decoration: none; text-align: center; box-shadow: 0 10px 40px rgba(182, 228, 43, .28); transition: transform .15s; }
  .kl-btn:hover { transform: translateY(-2px); }
  .kl-btn--sm { min-height: 52px; font-size: 15px; white-space: normal; }
  .kl-under { margin: 10px 0 0; font-size: 14px; color: var(--mut); }
  .kl-shot { margin: 0; }
  .kl-shot img { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line); cursor: zoom-in; background: #fff; }
  .kl-shot--hero img { box-shadow: 0 30px 80px rgba(0, 0, 0, .6), 0 0 0 4px rgba(182, 228, 43, .35); }
  .kl-shot figcaption { margin-top: 8px; font-size: 13px; color: var(--mut); }
  .kl-sec { padding: 64px 0; }
  .kl-sec--light { background: var(--warm); color: #17181b; }
  .kl-sec--light em { color: #4f6b00; }
  .kl-tag { display: inline-block; border-radius: 999px; padding: 6px 14px; background: var(--acc); color: var(--acc-ink); font-size: 12px; font-weight: 800; text-transform: uppercase; }
  .kl-tag--dark { background: #17181b; color: var(--acc); }
  .kl-h2 { font-size: clamp(28px, 4.4vw, 46px); line-height: 1.06; margin: 14px 0 18px; }
  .kl-p { margin: 0 0 16px; font-size: 17px; }
  .kl-p u { text-decoration-color: var(--acc); text-underline-offset: 4px; }
  .kl-holes { display: grid; gap: 14px; margin: 26px 0; }
  @media (min-width: 900px) { .kl-holes { grid-template-columns: repeat(3, 1fr); } }
  .kl-hole { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 22px; }
  .kl-hole__n { align-self: flex-start; background: var(--acc); color: var(--acc-ink); border-radius: 8px; padding: 6px 10px; font: 700 15px 'Oswald', sans-serif; text-transform: uppercase; }
  .kl-hole h3 { font-size: 22px; line-height: 1.15; margin: 14px 0 10px; }
  .kl-hole p { margin: 0 0 16px; color: #d6d7d3; flex: 1; }
  .kl-hole__price { border-top: 1px solid var(--line); padding-top: 12px; font-size: 15px; color: var(--mut); }
  .kl-hole__price b { color: var(--acc); }
  .kl-strip { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 20px 22px; margin-top: 24px; }
  .kl-strip b { display: block; font: 600 22px/1.2 'Oswald', sans-serif; text-transform: uppercase; }
  .kl-strip span { color: var(--mut); font-size: 15px; }
  .kl-funnel { list-style: none; padding: 0; margin: 22px 0; display: grid; gap: 8px; }
  .kl-funnel li { display: grid; grid-template-columns: 40px 1fr; gap: 0 14px; align-items: center; background: #fff; border-radius: 14px; padding: 12px 14px; border: 1px solid #e6e2d8; }
