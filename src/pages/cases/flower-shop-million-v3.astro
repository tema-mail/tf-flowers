<script is:inline>
  (function () {
    var lb = document.querySelector('[data-kl-lb]');
    var lbImg = lb.querySelector('img');
    document.querySelectorAll('.kl-shot img, .kl-who__photo img').forEach(function (img) {
      img.addEventListener('click', function () { lbImg.src = img.src; lbImg.alt = img.alt; lb.hidden = false; });
    });
    lb.addEventListener('click', function (e) { if (e.target !== lbImg) lb.hidden = true; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') lb.hidden = true; });

    document.querySelectorAll('[data-kinescope]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.querySelector('iframe')) return;
        var f = document.createElement('iframe');
        f.src = 'https://kinescope.io/embed/' + btn.getAttribute('data-kinescope') + '?autoplay=1';
        f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        f.allowFullscreen = true;
        f.title = btn.getAttribute('aria-label');
        btn.appendChild(f);
      });
    });

    /* Липкая панель на телефоне – после первого экрана */
    var sticky = document.querySelector('.kl3-sticky');
    var hero = document.querySelector('.kl-hero');
    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { sticky.classList.toggle('is-on', !es[0].isIntersecting); }).observe(hero);
    }

    /* Чек-лист мозолей: счёт и вывод */
    var boxes = document.querySelectorAll('[data-kl3-check] input');
    var verdict = document.querySelector('[data-kl3-verdict]');
    var cnt = document.querySelector('[data-kl3-count]'), txt = document.querySelector('[data-kl3-text]'), vbtn = document.querySelector('[data-kl3-btn]');
    function upd() {
      var k = 0; boxes.forEach(function (b) { if (b.checked) k++; });
      cnt.textContent = k + ' из ' + boxes.length;
      verdict.classList.toggle('is-hot', k >= 3);
      vbtn.hidden = k === 0;
      txt.textContent = k === 0 ? 'Отметьте всё, что было у вас. Здесь нет правильных ответов – только деньги, которые вы уже теряете.'
        : k <= 2 ? 'Дыры уже есть – и каждая стоит денег каждую неделю. Пока это дешевле закрыть, чем терпеть.'
        : k <= 5 ? 'Ваш магазин теряет деньги каждую неделю. Ровно с этого начинал магазин из кейса – до 251 ₽ за обращение и рекордного оборота.'
        : 'Это не невезение, это система, которая сливает ваши деньги. Магазин из кейса был в той же точке. Напишите Денису, пока не начался следующий праздник.';
    }
    boxes.forEach(function (b) { b.addEventListener('change', upd); });

    /* Калькулятор переплаты */
    var n = document.querySelector('[data-kl2-n]'), p = document.querySelector('[data-kl2-p]');
    var outM = document.querySelector('[data-kl2-month]'), outY = document.querySelector('[data-kl2-year]');
    function rub(v) { return Math.round(v).toLocaleString('ru-RU') + ' ₽'; }
    function calc() { var over = Math.max(0, (+p.value || 0) - 251) * Math.max(0, +n.value || 0); outM.textContent = rub(over); outY.textContent = rub(over * 12); }
    n.addEventListener('input', calc); p.addEventListener('input', calc); calc();

    /* Ближайший цветочный праздник */
    function motherDay(y) { var d = new Date(y, 10, 30); while (d.getDay() !== 0) d.setDate(d.getDate() - 1); return d; }
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var list = [];
    [today.getFullYear(), today.getFullYear() + 1].forEach(function (y) {
      list.push([new Date(y, 1, 14), 'Дня влюблённых'], [new Date(y, 2, 8), '8 Марта'], [new Date(y, 8, 1), '1 Сентября'], [motherDay(y), 'Дня матери'], [new Date(y, 11, 31), 'Нового года']);
    });
    list.sort(function (a, b) { return a[0] - b[0]; });
    var next = list.filter(function (h) { return h[0] >= today; })[0];
    var bar = document.querySelector('[data-kl2-holiday]');
    if (next && bar) {
      bar.querySelector('[data-kl2-hname]').textContent = next[1];
      bar.querySelector('[data-kl2-days]').textContent = Math.round((next[0] - today) / 864e5);
      bar.hidden = false;
    }
  })();
</script>
