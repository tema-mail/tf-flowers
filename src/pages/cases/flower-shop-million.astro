  .kl-bars .is-top { background: var(--acc); color: var(--acc-ink); box-shadow: 0 0 40px rgba(182, 228, 43, .35); }
  .kl-bars b { font: 700 clamp(14px, 2vw, 20px)/1.1 'Oswald', sans-serif; }
