  .kl-video__play iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .kl-video__icon { align-self: center; margin-top: 30%; width: 76px; height: 76px; border-radius: 50%; background: var(--acc); color: var(--acc-ink); display: grid; place-items: center; font-size: 28px; box-shadow: 0 0 0 10px rgba(182, 228, 43, .2); }
